# ===== Proveedores: groq | ollama | deepseek | openrouter | anthropic =====
PROVEEDOR_ORQUESTADOR=groq
PROVEEDOR_AGENTES=groq

# Vacío = modelo por defecto del proveedor (groq → openai/gpt-oss-120b, ollama → qwen3.5:9b)
MODELO_ORQUESTADOR=
MODELO_AGENTES=

# ===== Keys (solo las del proveedor que uses) =====
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434/v1

# ===== Límites =====
MAX_PASOS=25          # vueltas máximas por agente
MAX_PARALELO=2        # agentes a la vez (1 si usas Ollama)
MAX_TOKENS=4000       # tokens por respuesta
REINTENTOS=4          # reintentos ante errores temporales
MAX_HISTORIAL=10      # turnos que recuerda el chat

# true = te pregunta antes de cada comando de terminal
CONFIRMAR_COMANDOS=true

# ===== Carpetas (opcional) =====
# WORKSPACE=./workspace
# MEMORIA_DIR=./memoria
# LOGS_DIR=./logs
