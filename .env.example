# ===== Proveedores: ollama | groq | deepseek | openrouter | anthropic =====
PROVEEDOR_ORQUESTADOR=ollama
PROVEEDOR_AGENTES=ollama

# Vacío = modelo por defecto del proveedor (ollama → qwen3.5:9b)
MODELO_ORQUESTADOR=openai/gpt-oss-120b
MODELO_AGENTES=

# ===== Keys (solo las del proveedor que uses) =====
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434/v1

# ===== Workspace y límites =====
WORKSPACE=./workspace
MAX_PASOS=20
MAX_PARALELO=1
MAX_TOKENS=4000
CONFIRMAR_COMANDOS=true

# ===== Combinación recomendada para tu portátil (descomenta) =====
# Orquestador en la nube gratis (piensa mejor y rápido), agentes en local:
# PROVEEDOR_ORQUESTADOR=groq
# PROVEEDOR_AGENTES=ollama
# MAX_PARALELO=1
